# Clean Ubuntu 26.04 with NO dev tools: only the .deb (deps resolved by APT) + Xvfb tooling for screenshots.
FROM ubuntu:26.04
ARG VERSION
ENV DEBIAN_FRONTEND=noninteractive
COPY dist/meu-ubuntu_${VERSION}_amd64.deb /tmp/meu-ubuntu.deb
RUN apt-get update && apt-get install -y --no-install-recommends /tmp/meu-ubuntu.deb \
    && apt-get install -y --no-install-recommends xvfb xdotool imagemagick dbus-x11 fonts-ubuntu at-spi2-core \
    && rm -rf /var/lib/apt/lists/* /tmp/meu-ubuntu.deb \
    && (useradd -m -u 1000 -s /bin/bash utilizador 2>/dev/null || useradd -m -s /bin/bash utilizador)
